# Run this from h200-rjob0. The serve launcher starts rank 0 locally and SSHes
# into exactly one remote node for the headless rank.
HEAD_NODE_SSH=h200-rjob0

# Rank 0 address used by the DP coordinator + RPC. In this 2-machine wrapper,
# MASTER_ADDR=auto resolves from hostname/FQDN, matching `curl -v $(hostname)`.
# Set a concrete IP if you want to pin it explicitly.
MASTER_ADDR=auto

# Optional override for hostname-based discovery, e.g.
# MASTER_ADDR_HOSTNAME=gpu-lg-cmc-h-h200-2879
MASTER_ADDR_HOSTNAME=

# Optional override used only while auto-discovering the local outbound IPv4.
MASTER_ADDR_DISCOVERY_TARGET=

# Preferred: comma-separated remote headless nodes. For the 2-machine setup,
# keep exactly one remote host here.
REMOTE_NODE_SSHS=h200-rjob1

# Legacy per-node SSH settings kept for compatibility with the shared launcher.
NODE1_SSH=h200-rjob1
NODE2_SSH=
NODE3_SSH=

# Optional. Working directories and environment activation.
LOCAL_WORKDIR=/vllm
REMOTE_WORKDIR=/vllm
LOCAL_ENV_SCRIPT=
REMOTE_ENV_SCRIPT=
LOCAL_SHELL=zsh
LOCAL_SHELL_FLAGS=-ic
REMOTE_SHELL=zsh
REMOTE_SHELL_FLAGS=-ic

# Optional. Launcher/runtime knobs.
VLLM_BIN=/usr/local/bin/vllm
SSH_OPTS="-F /root/.ssh/config -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UpdateHostKeys=no"
DATA_PARALLEL_RPC_PORT=13345
LOG_DIR=/vllm/bench_0180_2m/logs

# Default serve target.
MODEL=/mnt/nvme1n1/ml_research/models/deepseek-v3-1024k/
SERVE_HOST=10.102.97.33
SERVE_PORT=8000

# Default 2-machine topology. Override from the script CLI if needed.
DP_SIZE=2
TP_SIZE=8
DCP_SIZE=8
DP_LOCAL_SIZE=1
API_SERVER_COUNT=1
ASYNC_SCHEDULING=1
LOAD_FORMAT=dummy
ENABLE_EXPERT_PARALLEL=1

# Defaults chosen to stay close to the current bench_0180 sweep setup.
GPU_MEMORY_UTILIZATION=0.9
MAX_NUM_SEQS=256
MAX_NUM_BATCHED_TOKENS=16384
DISABLE_LOG_STATS=0
