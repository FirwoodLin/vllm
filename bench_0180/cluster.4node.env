# Run the sweep from h200-rjob0. The manual launcher starts rank 0 locally and
# SSHes into the configured remote nodes for headless ranks.
HEAD_NODE_SSH=h200-rjob0

# Rank 0 address used by the DP coordinator + RPC. Keep MASTER_ADDR=auto unless
# you already know the peer-reachable IPv4 of h200-rjob0 and want to pin it.
MASTER_ADDR=auto

# Optional override for hostname-based discovery, e.g.
# MASTER_ADDR_HOSTNAME=gpu-lg-cmc-h-h200-2879
MASTER_ADDR_HOSTNAME=

# Optional override used only while auto-discovering the local outbound IPv4.
# Leave empty in the common case.
MASTER_ADDR_DISCOVERY_TARGET=

# Preferred: comma-separated remote headless nodes. For a 2-node run, keep only
# one remote host here, for example REMOTE_NODE_SSHS=h200-rjob1.
REMOTE_NODE_SSHS=h200-rjob1

# Legacy per-node SSH settings kept for compatibility with fixed 4-node scripts.
# These names rely on /root/.ssh/config populated by setup_root_ssh.sh.
NODE1_SSH=h200-rjob1
NODE2_SSH=
NODE3_SSH=

# Optional. Working directories and environment activation.
LOCAL_WORKDIR=/vllm
REMOTE_WORKDIR=/vllm
LOCAL_ENV_SCRIPT=
REMOTE_ENV_SCRIPT=
LOCAL_SHELL=zsh
LOCAL_SHELL_FLAGS=-ic
REMOTE_SHELL=zsh
REMOTE_SHELL_FLAGS=-ic

# Optional. Launcher/runtime knobs.
VLLM_BIN=/usr/local/bin/vllm
SSH_OPTS="-F /root/.ssh/config -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UpdateHostKeys=no"
DATA_PARALLEL_RPC_PORT=13345
LOG_DIR=/mnt/nvme1n1/ml_research/linbinbin1/vllm-v0180/bench_0180/logs
GPUS_PER_NODE=8

# Default serve target.
MODEL=/mnt/nvme1n1/ml_research/models/deepseek-v3-1024k/
SERVE_HOST= 10.102.97.179
SERVE_PORT=8000
BENCH_HOST= 10.102.97.179
BENCH_PORT=8000
SWEEP_HOST= 10.102.97.179
SWEEP_PORT=8000

# Default 2-node topology. Override from the script CLI if needed.
DP_SIZE=2
TP_SIZE=8
DCP_SIZE=8
DP_LOCAL_SIZE=1
API_SERVER_COUNT=1
ASYNC_SCHEDULING=1
LOAD_FORMAT=dummy
ENABLE_EXPERT_PARALLEL=1
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=256
MAX_NUM_BATCHED_TOKENS=16384
DISABLE_LOG_STATS=0

OUTPUT_DIR=/mnt/nvme1n1/ml_research/linbinbin1/vllm-v0180/bench_0180/results
EXPERIMENT_NAME=2dp8tp_async_mp
NUM_RUNS=1
SERVER_READY_TIMEOUT=1800
